{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "houdini-production-recipe-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "id", "title", "status", "workflow", "summary", "applicability", "scope", "inputs", "stages", "outputs", "side_effects", "acceptance", "rollback", "evidence", "tags"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "record_type": {"type": "string", "enum": ["recipe"]},
    "id": {"type": "string"},
    "title": {"type": "string"},
    "status": {"type": "string", "enum": ["candidate", "validated", "canonical", "deprecated"]},
    "workflow": {"type": "string"},
    "summary": {"type": "string"},
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use_when", "avoid_when"],
      "properties": {
        "use_when": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "avoid_when": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["houdini_versions", "engines", "projects"],
      "properties": {
        "houdini_versions": {"type": "array", "items": {"type": "string"}},
        "engines": {"type": "array", "items": {"type": "string"}},
        "projects": {"type": "array", "items": {"type": "string"}}
      }
    },
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "side_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_mutation", "expensive_cook", "file_write", "external_asset_write"],
      "properties": {
        "scene_mutation": {"type": "boolean"},
        "expensive_cook": {"type": "boolean"},
        "file_write": {"type": "boolean"},
        "external_asset_write": {"type": "boolean"}
      }
    },
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_ids", "experience_ids", "last_verified"],
      "properties": {
        "case_ids": {"type": "array", "items": {"type": "string"}},
        "experience_ids": {"type": "array", "items": {"type": "string"}},
        "last_verified": {"type": "string"}
      }
    },
    "tags": {"type": "array", "items": {"type": "string"}}
  }
}
